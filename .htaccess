# BEGIN DOM-U-MORYA PERMANENT DOTFILE GUARD v1
# Applied before publishing any release; retained by rollback.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
RewriteEngine On
# Only the standard root ACME token path is exempt from the dot-directory deny.
RewriteRule ^\.well-known/acme-challenge/[A-Za-z0-9_-]+$ - [END]
RewriteRule (^|/)\. - [F,END]
# END DOM-U-MORYA PERMANENT DOTFILE GUARD v1

# SEO-REDIRECT-001: canonical URLs behind Jino's HTTPS reverse proxy.
Options -Indexes

# THE_REQUEST excludes Apache's internal DirectoryIndex subrequest for /.
RewriteCond %{THE_REQUEST} \s/+index(?:\.html)?/*(?:\?|\s)
RewriteRule ^index(?:\.html)?/*$ https://zhk-dom-umorya.ru/ [R=301,END]

# Only existing public HTML pages; unknown URLs retain their 404 response.
RewriteRule ^(privacy|consent-personal-data|consent-analytics)\.html/+$ https://zhk-dom-umorya.ru/$1.html [R=301,END]

# Run before mod_dir: it sees backend HTTP even for public HTTPS requests.
# Keep DirectorySlash enabled and preserve real directories, including /privacy/.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.+)$ https://zhk-dom-umorya.ru/$1/ [R=301,END]

RewriteCond %{HTTP_HOST} !^zhk-dom-umorya\.ru$ [NC,OR]
RewriteCond %{HTTP:X-Forwarded-Protocol} !=https
RewriteRule ^ https://zhk-dom-umorya.ru%{REQUEST_URI} [R=301,END]
